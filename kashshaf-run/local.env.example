# Settings for a local run against kashshaf-run/supabase_emulator.py: no paid service is called.
# Copy to kashshaf-run/local.env and start the server with KASHSHAF_ENV_FILE=kashshaf-run/local.env
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_emulator
SUPABASE_SECRET_KEY=sb_secret_local_emulator
ANTHROPIC_API_KEY=
SERPAPI_KEY=
AGENT_COUNT=15
AGENT_MIN_RULE_SCORE=1
ALLOW_LOCAL_TEST_SITES=true
