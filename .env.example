# Supabase (Project Settings -> API Keys)
SUPABASE_URL=https://bkmwzkhkyhescyspeuxm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_vSkof4ZmB7d6VxSTj9pWoQ_TTNZ-4qD
# Secret key (sb_secret_...): server only, never put it in the browser or in git
SUPABASE_SECRET_KEY=

# Claude API key (console.anthropic.com). Without it the agents use rules only.
ANTHROPIC_API_KEY=
# Leave empty to call Anthropic directly; set for a compatible gateway
AGENT_BASE_URL=

# SerpAPI key (serpapi.com) for Google search, ads, AI Overviews and Maps results
SERPAPI_KEY=

# Agents
AGENT_COUNT=50
# Run the Claude agent only when rule signals reach this score (saves credit). 0 = every non-official URL.
AGENT_MIN_RULE_SCORE=0
# Minutes between automatic discovery rounds (0 = manual only)
DISCOVERY_INTERVAL_MIN=0
# Spending caps per hour, and seconds between patrol searches
SERP_MAX_PER_HOUR=20
AI_MAX_PER_HOUR=60
PATROL_INTERVAL_SEC=90
# Memory: hours before the same search or the same link is paid for / checked again
SEARCH_COOLDOWN_HOURS=24
AGENT_SEARCH_CACHE_HOURS=168
RECHECK_AFTER_HOURS=24

# Allow the local TEST scam pages (*.localhost). Set to false in production.
ALLOW_LOCAL_TEST_SITES=true
# Claude model for the agents
AGENT_MODEL=claude-opus-5-5

# Evidence for takedown requests: screenshot, page copy, WHOIS/RDAP and hosting data,
# captured when a link is judged fraud or suspicious. Screenshots use a local Chrome or Chromium.
EVIDENCE_AUTO=true
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
